{
  "manifestVersion": 5,
  "id": "kr.techforimpact.poster-a11y",
  "name": "포스터 접근성 검수",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": { "default": "포스터 접근성 검수" },
      "minimumSize": { "width": 260, "height": 300 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 320, "height": 640 },
      "preferredFloatingSize": { "width": 380, "height": 680 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
